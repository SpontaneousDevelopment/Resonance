# Copy to key.properties and fill in. Never commit the result.
#
# Create the keystore yourself — it is not generated by any script here, and it
# must be backed up somewhere you control. Losing it means you cannot ship an
# update to an app already on Play under this key.
#
#   keytool -genkey -v -keystore ~/resonance-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storeFile=/absolute/path/to/resonance-upload.jks
storePassword=
keyAlias=upload
keyPassword=
