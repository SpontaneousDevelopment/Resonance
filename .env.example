# Copy to .env and fill in. Never commit .env.
#
# The anon key is safe to ship in the client (Row-Level Security is what
# actually protects data). The service-role key must NEVER appear here or in
# the app — it belongs only in Edge Function secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-side only. Used by the coach-note Edge Function, never by the client.
ANTHROPIC_API_KEY=

# YouTube Data API key, used by tools/ingest to read a video's license field
# before downloading. Local tooling only.
YOUTUBE_API_KEY=
